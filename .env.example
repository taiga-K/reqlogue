# FastAPI
API_TITLE=reqlogue API
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Next.js BFF → API
API_BASE_URL=http://127.0.0.1:8000

# GPT-Realtime-Whisper (https://developers.openai.com/api/docs/models/gpt-realtime-whisper)
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-realtime-whisper
OPENAI_STT_LIVE=false

# OrcaRouter (https://docs.orcarouter.ai/introduction)
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=orcarouter/auto
ORCAROUTER_LIVE=false

# Enable only in local/e2e. Never set in production.
NEXT_PUBLIC_API_MOCKING=
