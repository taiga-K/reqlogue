{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "architecture": {},
    "check-stories": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "verify": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
