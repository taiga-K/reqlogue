#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

WITH_API=0
for arg in "$@"; do
  case "$arg" in
    --with-api) WITH_API=1 ;;
    --web-only) WITH_API=0 ;;
    -h|--help)
      cat <<'EOF'
Launch an isolated reqlogue verification instance.

Usage:
  .cursor/skills/verify-reqlogue/helpers/launch
  .cursor/skills/verify-reqlogue/helpers/launch --with-api

Environment:
  REQLOGUE_VERIFY_RUN_ID     default: UTC timestamp
  REQLOGUE_VERIFY_WEB_PORT   default: 3317
  REQLOGUE_VERIFY_API_PORT   default: 8017
  REQLOGUE_VERIFY_BASE_DIR   default: /tmp/reqlogue-verify

Starts Next.js with NEXT_PUBLIC_API_MOCKING=enabled so meeting capture
uses the in-app stub transcriber (no OpenAI). The FastAPI stub is
optional and only required to prove transcription-api.
EOF
      exit 0
      ;;
    *)
      echo "unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

mkdir -p "$VERIFY_BASE_DIR"

if [[ -f "$CURRENT_FILE" ]]; then
  existing="$(tr -d '[:space:]' < "$CURRENT_FILE")"
  if [[ -n "$existing" && -f "$(meta_file_for "$existing")" ]]; then
    echo "refuse: verification run $existing is already current." >&2
    echo "Doctor it with $SCRIPT_DIR/doctor or tear it down with $SCRIPT_DIR/cleanup." >&2
    echo "Do not attach this skill to a shared :3000 / :8000 / :3217 instance." >&2
    exit 1
  fi
fi

RUN_ID="${REQLOGUE_VERIFY_RUN_ID:-$(default_run_id)}"
WEB_PORT="${REQLOGUE_VERIFY_WEB_PORT:-3317}"
API_PORT="${REQLOGUE_VERIFY_API_PORT:-8017}"
WEB_URL="http://127.0.0.1:${WEB_PORT}"
API_URL="http://127.0.0.1:${API_PORT}"
RUN_DIR="$(run_dir_for "$RUN_ID")"
EVIDENCE_DIR="$(evidence_dir_for "$RUN_ID")"
META="$(meta_file_for "$RUN_ID")"

if [[ -f "$META" ]]; then
  echo "refuse: run $RUN_ID already has $META" >&2
  echo "Set a new REQLOGUE_VERIFY_RUN_ID or run cleanup first." >&2
  exit 1
fi

web_port_status=0
port_is_free "$WEB_PORT" || web_port_status=$?
if [[ "$web_port_status" -eq 2 ]]; then
  echo "refuse: cannot inspect port $WEB_PORT." >&2
  exit 1
fi
if [[ "$web_port_status" -ne 0 ]]; then
  echo "refuse: port $WEB_PORT is already listening. Pick REQLOGUE_VERIFY_WEB_PORT or stop that process." >&2
  echo "Never drive a shared instance on :3000 or Playwright e2e on :3217." >&2
  exit 1
fi
if [[ "$WITH_API" -eq 1 ]]; then
  api_port_status=0
  port_is_free "$API_PORT" || api_port_status=$?
  if [[ "$api_port_status" -eq 2 ]]; then
    echo "refuse: cannot inspect port $API_PORT." >&2
    exit 1
  fi
  if [[ "$api_port_status" -ne 0 ]]; then
    echo "refuse: port $API_PORT is already listening. Pick REQLOGUE_VERIFY_API_PORT or stop that process." >&2
    exit 1
  fi
fi

mkdir -p "$RUN_DIR" "$EVIDENCE_DIR"

API_PID=0
WEB_PID=0
LAUNCH_OK=0

cleanup_on_fail() {
  if [[ "$LAUNCH_OK" -eq 1 ]]; then
    return 0
  fi
  echo "launch failed; tearing down this incomplete run $RUN_ID" >&2
  if [[ "$WEB_PID" != "0" ]]; then
    kill_tree "$WEB_PID" || true
  fi
  if [[ "$API_PID" != "0" ]]; then
    kill_tree "$API_PID" || true
  fi
  rm -rf "$RUN_DIR"
  if [[ -f "$CURRENT_FILE" ]] && [[ "$(tr -d '[:space:]' < "$CURRENT_FILE")" == "$RUN_ID" ]]; then
    rm -f "$CURRENT_FILE"
  fi
}
trap cleanup_on_fail EXIT

if [[ ! -d "$REPO_ROOT/web/node_modules" ]]; then
  echo "installing web dependencies..."
  (cd "$REPO_ROOT/web" && pnpm install --frozen-lockfile)
fi

if [[ "$WITH_API" -eq 1 ]]; then
  if ! command -v uv >/dev/null 2>&1; then
    echo "refuse: uv is required for --with-api. Install uv, then retry." >&2
    echo "Repo command: cd api && uv sync --extra dev && REQLOGUE_MINDMAP=stub uv run uvicorn reqlogue_api.main.app:app --port $API_PORT" >&2
    exit 1
  fi
  echo "syncing api dependencies..."
  (cd "$REPO_ROOT/api" && uv sync --extra dev)
  CORS_ORIGINS="$WEB_URL,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3217"
  API_PID="$(
    start_session "$RUN_DIR/api.pid" "$RUN_DIR/api.log" "$REPO_ROOT/api" -- \
      env REQLOGUE_MINDMAP=stub CORS_ORIGINS="$CORS_ORIGINS" \
      uv run uvicorn reqlogue_api.main.app:app --host 127.0.0.1 --port "$API_PORT"
  )"
fi

WEB_PID="$(
  start_session "$RUN_DIR/web.pid" "$RUN_DIR/web.log" "$REPO_ROOT/web" -- \
    env NEXT_PUBLIC_API_MOCKING=enabled NEXT_PUBLIC_API_BASE_URL="$API_URL" \
    pnpm exec next dev --hostname 127.0.0.1 --port "$WEB_PORT"
)"

GIT_SHA="$(git -C "$REPO_ROOT" rev-parse HEAD)"

cat >"$META" <<EOF
REQLOGUE_VERIFY_RUN_ID=$RUN_ID
REQLOGUE_VERIFY_WEB_PORT=$WEB_PORT
REQLOGUE_VERIFY_API_PORT=$API_PORT
REQLOGUE_VERIFY_WEB_URL=$WEB_URL
REQLOGUE_VERIFY_API_URL=$API_URL
REQLOGUE_VERIFY_WEB_PID=$WEB_PID
REQLOGUE_VERIFY_API_PID=$API_PID
REQLOGUE_VERIFY_WITH_API=$WITH_API
REQLOGUE_VERIFY_MOCKING=enabled
REQLOGUE_VERIFY_GIT_SHA=$GIT_SHA
REQLOGUE_VERIFY_EVIDENCE_DIR=$EVIDENCE_DIR
REQLOGUE_VERIFY_RUN_DIR=$RUN_DIR
REQLOGUE_VERIFY_REPO_ROOT=$REPO_ROOT
EOF

printf '%s\n' "$RUN_ID" >"$CURRENT_FILE"

echo "waiting for web at $WEB_URL ..."
web_ready=0
for _ in $(seq 1 90); do
  if pid_alive "$WEB_PID" && html_has_reqlogue_home "$WEB_URL"; then
    web_ready=1
    break
  fi
  if ! pid_alive "$WEB_PID"; then
    echo "web process $WEB_PID exited. log:" >&2
    tail -n 80 "$RUN_DIR/web.log" >&2 || true
    exit 1
  fi
  sleep 1
done
if [[ "$web_ready" -ne 1 ]]; then
  echo "web did not become ready at $WEB_URL within 90s. log:" >&2
  tail -n 80 "$RUN_DIR/web.log" >&2 || true
  exit 1
fi

if [[ "$WITH_API" -eq 1 ]]; then
  echo "waiting for api at $API_URL/health ..."
  api_ready=0
  for _ in $(seq 1 60); do
    if pid_alive "$API_PID" && curl -fsS --max-time 3 "$API_URL/health" | grep -q '"status":"ok"'; then
      api_ready=1
      break
    fi
    if ! pid_alive "$API_PID"; then
      echo "api process $API_PID exited. log:" >&2
      tail -n 80 "$RUN_DIR/api.log" >&2 || true
      exit 1
    fi
    sleep 1
  done
  if [[ "$api_ready" -ne 1 ]]; then
    echo "api did not become ready at $API_URL/health within 60s. log:" >&2
    tail -n 80 "$RUN_DIR/api.log" >&2 || true
    exit 1
  fi
fi

LAUNCH_OK=1

cat <<EOF
launched run $RUN_ID
  web  $WEB_URL  pid $WEB_PID  mocking=enabled
  api  $([[ "$WITH_API" -eq 1 ]] && echo "$API_URL  pid $API_PID  transcriber=stub" || echo "not started (pass --with-api)")
  git  $GIT_SHA
  evidence  $EVIDENCE_DIR
  meta      $META
Ready when $WEB_URL returns the home headline 話すことに、集中しよう。
EOF
